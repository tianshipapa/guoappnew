{
  "name": "duanju-app",
  "private": true,
  "version": "1.2.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "serve": "node server/index.mjs",
    "test": "node server/test/smoke.mjs",
    "lint": "tsc --noEmit",
    "preview:pages": "npm run build && wrangler pages dev dist --port 8789",
    "deploy:pages": "npm run build && wrangler pages deploy dist",
    "deploy:vercel": "npx vercel deploy --prod"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "hls.js": "^1.5.17",
    "lucide-react": "^1.16.0",
    "mpegts.js": "^1.8.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.1",
    "wrangler": "^4.156.0"
  },
  "engines": {
    "node": "22.x"
  }
}
